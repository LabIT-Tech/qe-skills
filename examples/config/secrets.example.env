# Copy this file to secrets.<name>.env in your config folder and fill the values yourself.
# Never paste these values in a chat, a ticket or a file you share. Never commit this file.
# Restrict it to yourself:  chmod 600 secrets.<name>.env
# Skills read it only to make a call. An environment variable with the same name overrides it.

# Jira and Confluence: the email of your Atlassian account.
ATLASSIAN_EMAIL=

# Jira and Confluence: an API token.
# Create it at https://id.atlassian.com/manage-profile/security/api-tokens (Create API token).
ATLASSIAN_API_TOKEN=

# Xray Cloud only: an API key pair.
# Jira, Apps, Xray, Settings, API Keys, Create API Key.
# Xray Server or Data Center: leave these empty; the Atlassian values above are used.
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
